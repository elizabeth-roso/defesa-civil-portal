@using portal_defesa_civil.Models;
@using portal_defesa_civil.DTOs;
@model HomeViewModel;

<!--  precisamos escolher as fontes no google fonts e icons  -->
<!--  manter o bootstrap para componentes de estrutura, grid e flex, utilitários  -->
<!--  mas manter sass para visual de estilos e cores  -->
<!--  estou achando que no 90% de zoom do navegador fica mais bonito...  --> 

<div class="container m-0 p-0">
    <div class="row" >
        <div class="col-lg-8">
            <h1 class="fw-bold titulo--principal">DEFESA CIVIL</h1>
            <p> @Model.TextoPrincipal </p>
            <ul> 
                <li>
                    <span class="fw-bold"> Prevenção: </span> @Model.Prevencao
                </li>

                <li>
                    <span class="fw-bold"> Mitigação: </span> @Model.Mitigacao
                </li>

                <li>
                    <span class="fw-bold"> Preparação: </span> @Model.Preparacao
                </li>

                <li>
                    <span class="fw-bold"> Resposta: </span> @Model.Resposta
                </li>

                <li>
                    <span class="fw-bold"> Recuperação: </span> @Model.Recuperacao
                </li>
            </ul>

        </div>
        <div class="col-lg-3 align-self-center">
            <img width="400" height="330" src="~/img/defesa_civil_pg.png" class="border rounded-4"/>
        </div>

    </div>
</div>

@{
    var botoes = new List<string[]>
    {
        new string[] {"Previsão do Tempo", "https://www.climatempo.com.br/previsao-do-tempo/cidade/523/praiagrande-sp" },
        new string[] {"Receba Alertas", "https://www.gov.br/pt-br/servicos/solicitar-cadastro-para-recebimento-de-avisos-e-alertas-de-desastres" },
        new string[] {"Orientações", "https://www.gov.br/mdr/pt-br/assuntos/protecao-e-defesa-civil/saiba-como-agir" },
        new string[] {"Terminologia", " https://educacao.cemaden.gov.br/glossario/"},
        new string[] {"Documentações", "https://dadosabertos.praiagrande.sp.gov.br/geonetwork/srv/por/catalog.search#/metadata/67179132-5dbf-4d3d-bfc1-198161511db0"},
        new string[] {"Áreas de Risco", "https://dadosabertos.praiagrande.sp.gov.br/geonetwork/srv/por/catalog.search#/map"}
    };
    int i = 0;
}

<div class="container my-4 py-2">
    <h2 class="text-uppercase fs-3 titulo--secundario mb-4"> Acesso Rápido </h2>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var botao in botoes)
        {
            <a class="btn botao-redirecionamento" href="@botao[1]" target="_blank"> <span class="fw-bold">@botao[0]</span></a>
        }
    </div>
</div>

@if (Model.ListaNoticiasPrincipais.Items == null || !Model.ListaNoticiasPrincipais.Items.Any())
{
    <div class="container my-4 py-2">
        <h2 class="text-uppercase fs-3 titulo--secundario mb-4"> Notícias da Defesa Civil </h2>
        <p> Nenhuma notícia encontrada. </p>
    </div>
}
else
{
    <div class="container m-0 p-0">
        <div class="d-flex align-items-center">
            <h2 class="text-uppercase fs-3 titulo--principal">Notícias da Defesa Civil</h2>
        </div>
        <div class="row">
            <div class="col-md-7 d-flex align-items-center">
                <a asp-controller="Home" asp-action="Noticia" asp-route-id="@Model. .Items.First().Id" class="text-decoration-none">
                    <div class="card-noticia border-end border-2 rounded-3 p-2">
                        <div class="position-relative d-inline-block">
                            <img src="~/img/teste@(i++).png" width="635" height="373" class="rounded rounded-3"/>
                        </div>
                        <p class="fw-bold fs-4 titulo--noticia pt-2">@Model.ListaNoticiasPrincipais.Items.First().Titulo</p>
                        <p class="text-dark">@Model.ListaNoticiasPrincipais.Items.First().Subtitulo</p>
                        <p class="text-small text-muted"> Data de Publicação: @Model.ListaNoticiasPrincipais.Items.First().DataPublicacao </p>             
                    </div>
                </a>
            </div>    

            <div class="col-md-5">
                @foreach (NoticiaDTO noticia in Model.ListaNoticiasPrincipais.Items.Skip(1))
                {
                    <a asp-controller="Home" asp-action="Noticia" asp-route-id="@noticia.Id" class="flex-fill text-decoration-none">
                        <div class="d-flex flex-row gap-2 justify-content-start align-items-center my-3 border-end border-2 rounded-3 card-noticia card-noticia--pequena">
                            @* <img onclick="location.href='@noticia.Url'" src="@noticia.Fotos[0].Caminho"/> tem que procurar entre a lista de fotos aquele que tem nome igual ao Noticia.ImagemPrincipal *@
                            <div class="position-relative d-inline-block">
                                <img src="~/img/teste@(i++).png" width="194" height="115" class="rounded rounded-3 m-0 p-0"/>
                            </div>
                            <div class="d-flex flex-column">
                                <p class="fw-bold titulo--noticia p-2" >@noticia.Titulo</p>
                                <p class="text-muted fs-6"> Data de Publicação: @noticia.DataPublicacao </p>  
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
        @{
            int proximaPagina = Model.ListaNoticiasPrincipais.Page + 1;
        }
        @if(Model.ListaNoticiasPrincipais.HasNextPage)
        {
            
            <div class="d-flex justify-content-end"> 
                <a class="text-small text-bold text-decoration-none" asp-controller="Home" asp-action="TodasNoticias"> Ver mais... </a>
            </div>
        }

        @* opções do que eu posso fazer: 
            Para exibir o restande de notícias na Index, é uma boa ideia ter uma função do controler que vai chamar uma partial que exibe mais umas 10 notícias, e vai retornar o html para a view, e a view vai exibir na tela?
            ao clicar neste Ver mais, ele vai ter que ser excluído da tela, e vai ser exibido o html retornado pelo controller. a partial vai ter uma vermais também, que vai ter seu asp-route-pagina incrementado, e vai chamar o controller novamente, que vai chamar a partial novamente, e assim por diante.
         *@

    </div> 
}